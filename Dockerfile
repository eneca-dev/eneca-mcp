# 1. Используем легкий Node.js (версия 18 или 20)
FROM node:18-alpine

# 2. Создаем рабочую папку
WORKDIR /app

# 3. Сначала копируем зависимости (для кэширования)
COPY package*.json ./

# 4. Устанавливаем библиотеки
RUN npm install --production

# 5. Копируем весь остальной код
COPY . .

# 6. Открываем порт 8080 (как мы договорились для MCP)
EXPOSE 8080

# 7. Команда запуска
# ВАЖНО: Убедись, что в package.json есть скрипт "start"
CMD ["npm", "start"]